#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct DensityLayer {
    float width;
    float expTerm;
    float expScale;
    float linearTerm;
    float constantTerm;
    float pad0;
    float pad1;
    float pad2;
};

layout(std140, set = 0, binding = 0) uniform AtmosphereUBO {
    vec4 solarIrradiance;      // xyz: irradiance, w: sunAngularRadius
    vec4 rayleighScattering;   // xyz: rayleighScattering, w: bottomRadius
    vec4 rayleighAbsorption;   // xyz: rayleighAbsorption, w: topRadius
    vec4 mieScattering;        // xyz: mieScattering, w: mieAnisotropy
    vec4 mieAbsorption;        // xyz: mieAbsorption, w: unused
    vec4 absorptionExtinction; // xyz: absorptionExtinction, w: unused
    vec4 groundAlbedo;         // xyz: groundAlbedo, w: unused
    DensityLayer rayleighDensity[2];
    DensityLayer mieDensity[2];
    DensityLayer absorptionDensity[2];
} u_Atmosphere;

layout(set = 0, binding = 1) uniform sampler2D inTransmittanceLUT;
layout(set = 0, binding = 2) uniform sampler2D inMultiScatterLUT;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outSkyViewLUT;

layout(push_constant) uniform SkyViewPushConstants {
    vec3 cameraPosition;
    float cameraAltitude;
    vec3 sunDirection;
    float sunIntensity;
} pc;

const float PI = 3.14159265358979323846;

float getLayerDensity(DensityLayer layer, float altitude) {
    return layer.expTerm * exp(layer.expScale * altitude) + layer.linearTerm * altitude + layer.constantTerm;
}

float getProfileDensity(DensityLayer layers[2], float altitude) {
    if (layers[0].width > 0.0) {
        return altitude < layers[0].width ? getLayerDensity(layers[0], altitude) : getLayerDensity(layers[1], altitude);
    }
    return getLayerDensity(layers[0], altitude);
}

bool raySphereIntersect(vec3 orig, vec3 dir, float radius, out float t0, out float t1) {
    float b = dot(orig, dir);
    float c = dot(orig, orig) - radius * radius;
    float d = b * b - c;
    if (d < 0.0) return false;
    float s = sqrt(d);
    t0 = -b - s;
    t1 = -b + s;
    return true;
}

vec2 transmittanceParamsToUV(float r, float mu, float bottomR, float topR) {
    float H = sqrt(max(0.0, topR * topR - bottomR * bottomR));
    float rho = sqrt(max(0.0, r * r - bottomR * bottomR));
    
    float discriminant = r * r * (mu * mu - 1.0) + topR * topR;
    float d = max(0.0, -r * mu + sqrt(max(0.0, discriminant)));
    
    float d_min = topR - r;
    float d_max = rho + H;
    float x_mu = (d - d_min) / max(0.0001, d_max - d_min);
    float x_r = rho / max(0.0001, H);
    return clamp(vec2(x_mu, x_r), 0.0, 1.0);
}

vec3 sampleTransmittanceLUT(float r, float mu) {
    float bottomR = u_Atmosphere.rayleighScattering.w;
    float topR = u_Atmosphere.rayleighAbsorption.w;
    vec2 uv = transmittanceParamsToUV(r, mu, bottomR, topR);
    return texture(inTransmittanceLUT, uv).rgb;
}

vec3 sampleMultiScatterLUT(float r, float sunCos) {
    float bottomR = u_Atmosphere.rayleighScattering.w;
    float topR = u_Atmosphere.rayleighAbsorption.w;
    float u = clamp(sunCos * 0.5 + 0.5, 0.0, 1.0);
    float v = clamp((r - bottomR) / (topR - bottomR), 0.0, 1.0);
    return texture(inMultiScatterLUT, vec2(u, v)).rgb;
}

float rayleighPhase(float cosTheta) {
    return 3.0 / (16.0 * PI) * (1.0 + cosTheta * cosTheta);
}

float hgPhase(float g, float cosTheta) {
    float g2 = g * g;
    return 1.0 / (4.0 * PI) * ((1.0 - g2) / pow(max(0.0001, 1.0 + g2 - 2.0 * g * cosTheta), 1.5));
}

void uvToSkyViewParams(vec2 uv, float r, float bottomR, float topR, out float viewZenithCos, out float azimuth) {
    azimuth = uv.x * PI;

    // Non-linear mapping around horizon
    float H = sqrt(max(0.0, topR * topR - bottomR * bottomR));
    float horizonCos = -sqrt(max(0.0, 1.0 - (bottomR * bottomR) / (r * r)));
    
    float v = uv.y;
    if (v < 0.5) {
        float coord = 1.0 - (2.0 * v);
        coord = coord * coord;
        viewZenithCos = horizonCos - coord * (1.0 + horizonCos);
    } else {
        float coord = (v - 0.5) * 2.0;
        coord = coord * coord;
        viewZenithCos = horizonCos + coord * (1.0 - horizonCos);
    }
    viewZenithCos = clamp(viewZenithCos, -1.0, 1.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outSkyViewLUT);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    
    float bottomR = u_Atmosphere.rayleighScattering.w;
    float topR = u_Atmosphere.rayleighAbsorption.w;
    
    float r = clamp(bottomR + max(0.0, pc.cameraAltitude), bottomR + 1.0, topR - 1.0);
    vec3 camPos = vec3(0.0, r, 0.0);

    float viewZenithCos, azimuth;
    uvToSkyViewParams(uv, r, bottomR, topR, viewZenithCos, azimuth);

    float viewZenithSin = sqrt(max(0.0, 1.0 - viewZenithCos * viewZenithCos));
    vec3 viewDir = vec3(viewZenithSin * cos(azimuth), viewZenithCos, viewZenithSin * sin(azimuth));

    vec3 sunDir = normalize(pc.sunDirection);
    float sunZenithCos = clamp(sunDir.y, -1.0, 1.0);
    float sunZenithSin = sqrt(max(0.0, 1.0 - sunZenithCos * sunZenithCos));
    vec3 lutSunDir = vec3(sunZenithSin, sunZenithCos, 0.0);

    float t0, t1;
    if (!raySphereIntersect(camPos, viewDir, topR, t0, t1) || t1 <= 0.0) {
        imageStore(outSkyViewLUT, coord, vec4(0.0));
        return;
    }

    float tGround0, tGround1;
    bool hitGround = raySphereIntersect(camPos, viewDir, bottomR, tGround0, tGround1) && tGround0 > 0.0;
    float maxDist = hitGround ? tGround0 : t1;

    const int MARCH_STEPS = 30;
    float dt = maxDist / float(MARCH_STEPS);
    vec3 throughput = vec3(1.0);
    vec3 inscattering = vec3(0.0);

    float cosThetaSun = dot(viewDir, lutSunDir);
    float phaseR = rayleighPhase(cosThetaSun);
    float phaseM = hgPhase(u_Atmosphere.mieScattering.w, cosThetaSun);

    for (int i = 0; i < MARCH_STEPS; ++i) {
        float t = (float(i) + 0.5) * dt;
        vec3 p = camPos + viewDir * t;
        float sampleH = length(p) - bottomR;
        if (sampleH < 0.0) break;

        float dR = max(0.0, getProfileDensity(u_Atmosphere.rayleighDensity, sampleH));
        float dM = max(0.0, getProfileDensity(u_Atmosphere.mieDensity, sampleH));
        float dO = max(0.0, getProfileDensity(u_Atmosphere.absorptionDensity, sampleH));

        vec3 scaR = u_Atmosphere.rayleighScattering.xyz * dR;
        vec3 scaM = u_Atmosphere.mieScattering.xyz * dM;
        vec3 extR = scaR;
        vec3 extM = (u_Atmosphere.mieScattering.xyz + u_Atmosphere.mieAbsorption.xyz) * dM;
        vec3 extO = u_Atmosphere.absorptionExtinction.xyz * dO;

        vec3 extinction = extR + extM + extO;
        vec3 sampleTransmittance = exp(-extinction * dt);

        float upP = length(p);
        float sunCosP = dot(p, lutSunDir) / upP;
        vec3 sunTransmittance = sampleTransmittanceLUT(upP, sunCosP);
        vec3 multiScatter = sampleMultiScatterLUT(upP, sunCosP);

        vec3 S = sunTransmittance * (scaR * phaseR + scaM * phaseM) + multiScatter * (scaR + scaM);
        vec3 Sint = (S - S * sampleTransmittance) / max(vec3(0.00001), extinction);
        inscattering += throughput * Sint;

        throughput *= sampleTransmittance;
    }

    imageStore(outSkyViewLUT, coord, vec4(inscattering, 1.0));
}
