{
    "title": "CrimsonEngine",
    "width": 1280,
    "height": 720,
    "startScenePath": "scenes/default.scene",
    "shadowsEnabled": true,
    "shadowResolution": 4096,
    "shadowDistance": 80,
    "shadowBias": 0.0005,
    "shadowNormalBias": 1.5,
    "cascadeSplitLambda": 0.85,
    "softShadows": true,
    "tonemapperMode": 0,
    "tonemapExposure": 1,
    "tonemapGamma": 2.2,
    "tonemapContrast": 1,
    "tonemapSaturation": 1,
    "ssaoEnabled": true,
    "ssaoRadius": 0.5,
    "ssaoBias": 0.025,
    "ssaoIntensity": 1.5,
    "ssaoPower": 1.5,
    "ssaoSamples": 16,
    "ssaoDebugAO": false
}
